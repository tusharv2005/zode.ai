<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="zode.jetbrains.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider implementation="ai.zodecode.backend.rpc.ZodeAppRpcApiProvider"/>
        <platform.rpc.backend.remoteApiProvider implementation="ai.zodecode.backend.rpc.ZodeProjectRpcApiProvider"/>
        <platform.rpc.backend.remoteApiProvider implementation="ai.zodecode.backend.rpc.ZodeSessionRpcApiProvider"/>
        <platform.rpc.backend.remoteApiProvider implementation="ai.zodecode.backend.rpc.ZodeMigrationRpcApiProvider"/>
        <applicationService serviceImplementation="ai.zodecode.backend.migration.ZodeBackendLegacyMigrationStoreService"/>
    </extensions>
</idea-plugin>
