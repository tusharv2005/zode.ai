    "submenus": [
      {
        "id": "zode-code.new.editorContextMenu",
        "label": "Zode Code"
      },
      {
        "id": "zode-code.new.terminalContextMenu",
        "label": "Zode Code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zode-code.new.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.zodeClawOpen",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "zode-code.new.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "zode-code.new.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.zodeClawOpen",
          "group": "navigation@3",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@4",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.profileButtonClicked",
          "group": "navigation@5",
          "when": "view == zode-code.SidebarProvider"
        },
        {
          "command": "zode-code.new.sidebarTitle.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == zode-code.SidebarProvider"
        }
      ],
      "scm/title": [
        {
          "command": "zode-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "zode-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "zode-code.new.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "zode-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == zode-code.new.TabPanel"
        },
        {
          "command": "zode-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == zode-code.new.TabPanel"
        },
        {
          "command": "zode-code.new.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == zode-code.new.TabPanel"
        },
        {
          "command": "zode-code.new.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == zode-code.new.TabPanel"
        }
      ],
      "editor/context": [
        {
          "submenu": "zode-code.new.editorContextMenu",
          "group": "1_zodecode"
        }
      ],
      "zode-code.new.editorContextMenu": [
        {
          "command": "zode-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "zode-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "zode-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "zode-code.new.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "zode-code.new.terminalContextMenu",
          "group": "2_zodecode"
        }
      ],
      "zode-code.new.terminalContextMenu": [
        {
          "command": "zode-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "zode-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "zode-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zode-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "zode-code.new.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "zode-code.new.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "zode-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "zode-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "zode-code.new.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "zode-code.new.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.newTerminal",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.advancedWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'zode-code.new.AgentManagerPanel'"
      },
      {
        "command": "zode-code.new.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "sideBarFocus && zode-code.new.sidebarVisible || activeWebviewPanelId == 'zode-code.new.AgentManagerPanel' || activeWebviewPanelId == 'zode-code.new.TabPanel'"
      },
      {
        "command": "zode-code.new.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "sideBarFocus && zode-code.new.sidebarVisible || activeWebviewPanelId == 'zode-code.new.AgentManagerPanel' || activeWebviewPanelId == 'zode-code.new.TabPanel'"
      },
      {
        "command": "zode-code.new.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && zode-code.new.autocomplete.hasSuggestions"
      },
      {
        "command": "zode-code.new.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && zodecode.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "zode-code.new.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && zodecode.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "zode-code.new.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && zode-code.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "zode-code.new.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && zode-code.nextEdit.hasPendingSuggestion"
      }
    ],
